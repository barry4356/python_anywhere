  "Keywords": {
    "Mischievous": "When attacking, targets must re-roll unmodified Defense results of 6 when blocking hits from this model's weapons.",
    "Bounding": "When this unit is activated, you may move all models with this rule in it by up to D3+1\".",
    "Caster Group": "Pick one model with this rule in this unit to have Caster(X), where X is the total number of models with this rule in this unit.",
    "Regeneration": "When this model takes a wound, roll one die. On a 5+ the wound is ignored.",
    "Strider": "This model ignores movement penalties from difficult terrain.",
    "Tough(X)": "This model must take X wounds before being removed as a casualty."
  },
  "SpellBooks": {
    "Army Spells": {
      "Wolf Resilience (1)": "Pick one friendly unit within 12\", which gets +1 to Defense rolls once (next time the effect would apply).",
      "Biting Bat (1)": "Pick one enemy unit within 6\", which takes 1 hit with Deadly(3) and Hazardous.",
      "Bat Thirst (2)": "Pick up to two enemy units within 18\" in line of sight, which friendly units gets Piercing Fighter against once.",
      "Stinging Spider (2)": "Pick one enemy unit within 6\", which takes 6 hits with Bane.",
      "Spider Might (3)": "Pick up to three friendly units within 18\", which get Enhanced Mischievous once.",
      "Pouncing Wolf (3)": "Pick one enemy unit within 18\" in line of sight, which takes 6 hits with AP(2)."
