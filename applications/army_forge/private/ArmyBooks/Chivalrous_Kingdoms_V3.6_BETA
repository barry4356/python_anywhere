  "Keywords": {
    "Vale Oath": "If a unit where most models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.",
    "Bravery Buff": "Once per activation, before attacking, pick one friendly unit within 12\", which gets +1 to Morale Test rolls once.",
    "Melee Slayer": "When charging, this model's weapons get AP(+2) if most models in the target have Tough(3) or higher.",
    "Spell Resistance": "When a unit where most models have this rule takes wounds, roll one die. If the wound was from a spell, it is ignored on a 2+. If not from a spell, ignored on a 6+.",
    "Versatile Warrior": "When activated, pick one: until the end of activation, when shooting/charging enemies over 9\"/6\" away, models get AP(+1) or +1 to hit rolls."
  },
  "SpellBooks": {
    "Army Spells": {
      "Protection of the Huntress (1)": "Pick one friendly unit within 12\", which gets Fortified once.",
      "Searing Gaze (1)": "Pick one enemy unit within 6\", which takes 3 hits with Bane.",
      "Curse of the Huntress (2)": "Pick up to two enemy units within 18\" in line of sight, which friendly units get Surge against once.",
      "Wrath of the Huntress (2)": "Pick one enemy unit within 12\" in line of sight, which takes 4 hits with AP(2).",
      "Great Hunt (3)": "Pick up to three friendly units within 18\", which get Enhanced Vale Oath once.",
      "Cleansing Light (3)": "Pick one enemy model within 24\" in line of sight, which takes 3 hits with AP(3) and Obliterate."
    }
