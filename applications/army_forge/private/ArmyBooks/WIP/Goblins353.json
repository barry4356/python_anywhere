  "Keywords": {
    "Mischievous": "When attacking, targets must re-roll unmodified Defense results of 6 when blocking hits from this model's weapons.",
    "Bounding": "When this unit is activated, you may place all models with this rule in it anywhere fully within D3+1\" of their position.",
    "Regeneration": "When this model takes a wound, roll one die. On a 5+ the wound is ignored.",
    "Shred": "On unmodified results of 1 to block hits, this weapon deals 1 extra wound.",
    "Strider": "This model may ignore the effects of difficult terrain when moving.",
    "Caster Group": "Pick one model with this rule in this unit to have Caster(X), where X is the total number of models with this rule in this unit.",
    "Unpredictable Fighter": "When in melee, roll one die: on a 1-3 they get AP(+1), and on a 4-6 they get +1 to hit rolls instead.",
    "Good Fighter": "This model gets +1 to hit rolls in melee.",
    "Stealth": "Enemies get -1 to hit rolls when shooting at units where all models have this rule."
  },
