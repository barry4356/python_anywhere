  "Keywords": {
    "Sturdy": "If most models in this unit have this rule, they get +1 to Defense rolls when shot/charged from over 9\"/6\" away.",
    "Crossing Strike": "Once per activation, when this model moves through enemy units, pick one of them and attack with this weapon as if it was shooting. This weapon may only be used in this way.",
    "Cumbersome": "May only use Hold or Advance actions, but can’t shoot when moving.",
    "Infiltrate": "Counts as having Ambush, but may be deployed anywhere over 3\" away from enemy unit.",
    "Melee Slayer": "When charging, this model's weapons get AP(+2) if most models in the target have Tough(3) or higher.",
    "Ravage": "Once per round, when it’s this model’s turn to strike in melee, roll X dice before attacking, unless this unit is Fatigued. For each 6+ the target takes one wound.",
    "Scourge": "For each unmodified result of 1 to block hits, enemies count as having taken 2 extra wounds when checking who won melee, or if shooting wounds would trigger Morale Tests.",
    "Slow": "This model moves -1\" on Advance actions, and -2\" on Rush/Charge actions.",
    "Fearless": "This model gets +1 to its morale tests.",
    "Furious": "Whenever this model charges, its melee weapons get +1 hit for each unmodified roll of 6 to hit."
  },
  "SpellBooks": {
    "Army Spells": {
      "Rune of Spite (1)": "Pick one enemy unit within 18\" in line of sight, which moves -2\" when using Advance actions and -4\" when using Rush/Charge actions once (next time the effect would apply).",
      "Rune of Breaking (1)": "Pick one enemy model within 18\" in line of sight, which takes 2 hits with AP(1). This effect is resolved as if the target was a unit of [1].",
      "Rune of Protection (2)": "Pick up to two friendly units within 12\", which get Enhanced Sturdy once (next time the effect would apply).",
      "Rune of Smiting (2)": "Pick one enemy unit within 18\" in line of sight, which takes 2 hits with Blast(3).",
      "Rune of Battle (3)": "Pick up to three friendly units within 18\", which get Rapid Charge once (next time the effect would apply).",
      "Rune of Cleaving (3)": "Pick one enemy unit within 18\" in line of sight, which takes 6 hits with Scourge."
    }
  }
}
