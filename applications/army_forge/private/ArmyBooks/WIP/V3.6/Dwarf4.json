  "Keywords": {
    "Sturdy": "If most models in this unit have this rule, they get +1 to Defense rolls when shot/charged from over 9\"/6\" away.",
    "Slow": "This model moves -1\" when using Advance actions and -2\" when using Rush/Charge actions.",
    "Fearless": "This model gets +1 to its morale tests.",
    "Furious": "This model gets +1 attack on the charge.",
    "Melee Slayer": "When charging, this model's weapons get AP(+2) if most models in the target have Tough(3) or higher.",
    "Scout": "This model may be deployed after all other units, and may be placed anywhere over 12\" away from enemy units.",
    "Rending": "Unmodified hit rolls of 6 get AP(4) and ignore Regeneration.",
    "Bane": "This weapon gets +1 to hit rolls.",
    "Blast(X)": "This weapon ignores cover and multiplies hits by X.",
    "Scourge": "For each unmodified result of 1 to block hits, enemies count as having taken 2 extra wounds for melee resolution/morale.",
    "Unwieldy": "Strikes last when charging.",
    "Deadly(X)": "Each wound dealt is multiplied by X."
  },
