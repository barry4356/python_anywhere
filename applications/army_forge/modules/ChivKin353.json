  "Keywords": {
    "Vale Oath": "If a unit where all models have this rule is Shaken at the beginning of the round, roll one die. On a 4+, it stops being Shaken.",
    "Courage Buff": "Once per activation, before attacking, pick one friendly unit within 12\", which gets +1 to morale test rolls once.",
    "Fortified": "When units where all models have this rule take hits, those hits count as having AP(-1), to a min. of AP(0).",
    "Furious Buff": "Once per activation, before attacking, pick one friendly unit within 12\", which gets Furious once.",
    "Heavy Impact": "Counts as having Impact(X) with hits that have AP(1).",
    "Melee Shrouding": "Enemies get -3\" movement to a min. of 6\" when trying to charge units where all models have this rule.",
    "Melee Slayer": "When this model charges, its weapons get AP(+2) if most models in the target have Tough(3) or higher.",
    "Piercing Shooter": "This model gets AP(+1) when shooting.",
    "Precision Growth": "Place one marker on this unit at the beginning of each round. For every two markers, models in this unit get +1 to hit rolls.",
    "Ranged Slayer": "When this model shoots at enemies over 9\" away, its weapons get AP(+2) if most models in the target have Tough(3) or higher.",
    "Rapid Rush": "This model moves +6\" when using Rush actions.",
    "Shred": "On unmodified results of 1 to block hits, this weapon deals 1 extra wound.",
    "Surge": "On unmodified results of 6 to hit, this weapon deals 1 extra hit.",
    "Tear": "Against units where most models have Tough(9) or higher, this weapon gets AP(+4).",
    "Vanguard": "After this model is deployed, it may be placed anywhere fully within 9” of its position.",
    "Versatile Attack": "When activated, pick one: until end of activation, shooting/charging enemies over 9\" away gives either AP(+1) or +1 to hit rolls."
  },
  "SpellBooks": {
